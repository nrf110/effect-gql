{
  "name": "@effect-gql/federation",
  "version": "2.0.0",
  "description": "Apollo Federation 2.x support for @effect-gql/core",
  "repository": {
    "url": "https://github.com/nrf110/effect-gql"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@effect-gql/core": "^2.0.0",
    "effect": "^4.1.1",
    "graphql": "^16.0.0"
  },
  "devDependencies": {
    "@effect-gql/core": "workspace:*",
    "effect": "^4.1.1",
    "graphql": "^16.0.0"
  },
  "keywords": [
    "effect",
    "graphql",
    "federation",
    "apollo",
    "microservices",
    "subgraph"
  ],
  "license": "MIT"
}
